rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "TCksXZW37GMPS5AaKXXtlEJL1iF3";
    }

    function validDraw() {
      return request.resource.data.keys().hasOnly(["people", "ticketPrice"])
        && request.resource.data.keys().hasAll(["people", "ticketPrice"])
        && request.resource.data.people is list
        && request.resource.data.people.size() <= 100
        && request.resource.data.ticketPrice in [500000, 1000000];
    }

    match /draws/current {
      allow read: if true;
      allow create, update: if isAdmin() && validDraw();
      allow delete: if false;
    }
  }
}
